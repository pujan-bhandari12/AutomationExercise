{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-1234-56789abcdef0",
    "name": "Automation Exercise API Suite",
    "description": "End-to-end API test suite covering Products, Brands, Search, and User Account lifecycle.",
