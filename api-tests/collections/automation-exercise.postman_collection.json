                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "    pm.expect(jsonData.message).to.eql(\"User exists!\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "{{testEmail}}", "type": "text" },
                { "key": "password", "value": "{{testPassword}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/verifyLogin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "verifyLogin"]
            }
          }
        },
        {
          "name": "DELETE User Account (Cleanup)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Account deleted successfully\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.responseCode).to.eql(200);",
                  "    pm.expect(jsonData.message).to.eql(\"Account deleted!\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "email", "value": "{{testEmail}}", "type": "text" },
                { "key": "password", "value": "{{testPassword}}", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/deleteAccount",
              "host": ["{{baseUrl}}"],
              "path": ["api", "deleteAccount"]
